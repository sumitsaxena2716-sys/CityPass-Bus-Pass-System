# Optional stable secret for local development. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Set to 1 only when the app is served over HTTPS.
COOKIE_SECURE=0
# Optional absolute or relative SQLite database path.
# CITYPASS_DATABASE=citypass.db
